pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/CloudDevopsRavina/simple-java-maven-app.git'
            }
        }
        stage('Build') {
            steps {
                sh 'mvn clean compile'
            }
        }
        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn sonar:sonar'
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
        stage('Package') {
            steps {
                sh 'mvn package'
            }
        }
        stage('Docker Build') {
            steps {
                sh 'docker build -t simple-java-maven-app:${BUILD_NUMBER} .'
            }
        }
        stage('Trivy Image Scan') {
            steps {
                sh '''
                trivy image \
                --severity CRITICAL \
                --format table \
                -o trivy-report.txt \
                simple-java-maven-app:${BUILD_NUMBER}
                '''
                
                archiveArtifacts artifacts: 'trivy-report.txt'
            }
        }
        stage('Push to ECR') {
            steps {
                sh '''
                ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)

                aws ecr get-login-password --region ap-south-1 | \
                docker login --username AWS --password-stdin \
                ${ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com

                docker tag simple-java-maven-app:${BUILD_NUMBER} \
                ${ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com/simple-java-maven-app:${BUILD_NUMBER}

                docker push \
                ${ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com/simple-java-maven-app:${BUILD_NUMBER}
                '''
            }
        }
        stage('Checkout K8s Repo') {
    steps {
           git branch: 'main',
            url: 'git@github.com:CloudDevopsRavina/kubernetes-project.git'
        }
    }

       stage('Update Deployment YAML') {
    steps {
             sh '''
        FILE=day-2-workernode-components/deployment.yml

        sed -i "s|image:.*|image: 383946777397.dkr.ecr.ap-south-1.amazonaws.com/simple-java-maven-app:${BUILD_NUMBER}|g" $FILE

        echo "Updated file:"
        grep image $FILE

        git config user.name "Jenkins"
        git config user.email "jenkins@example.com"

        git add day-2-workernode-components/deployment.yml

        git commit -m "Updated image tag to ${BUILD_NUMBER}" || echo "No changes to commit"

        git push origin main
        '''
    }
}
   
    }
}
